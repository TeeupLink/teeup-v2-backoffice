# 백오피스 환경변수 예시
#
# 이 파일을 .env 로 복사한 뒤 값을 채웁니다. .env 는 커밋되지 않습니다.
#   cp .env.example .env
#
# 경고: Vite는 VITE_ 접두사가 붙은 변수를 브라우저 번들에 그대로 넣습니다.
#       서버 시크릿(토스 시크릿 키 등)을 두지 마세요. 권한 검증은 백엔드에서 수행합니다.

# 개발 서버가 /api 를 프록시할 백엔드 주소 (프로덕션은 nginx 상대 경로 사용)
VITE_API_BASE_URL=http://localhost:7777

# 개발 서버 포트 / 백엔드 포트
VITE_ADMIN_PORT=
VITE_BACKEND_PORT=7777

# 구글 로그인 클라이언트 ID (공개값)
VITE_GOOGLE_CLIENT_ID=

# 사용자 앱 URL (클럽 공지/규정/회비 보기 링크)
VITE_CLIENT_URL=

# 토스페이먼츠 클라이언트 키 (공개값) — 빌링 샌드박스 전용, 테스트 키만
VITE_TOSS_CLIENT_KEY=
